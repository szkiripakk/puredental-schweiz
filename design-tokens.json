{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "font": {
      "family": {
        "primary": { "$value": "Manrope, Inter, Helvetica Neue, Arial, sans-serif", "$type": "fontFamily" }
      },
      "weight": {
        "regular": { "$value": 400, "$type": "fontWeight" },
        "medium": { "$value": 500, "$type": "fontWeight" },
        "semibold": { "$value": 600, "$type": "fontWeight" },
        "bold": { "$value": 700, "$type": "fontWeight" },
        "extrabold": { "$value": 800, "$type": "fontWeight" }
      }
    },
    "color": {
      "primary": {
        "50": { "$value": "#EEF4FF", "$type": "color" },
        "100": { "$value": "#DFEAFF", "$type": "color" },
        "200": { "$value": "#BED4FF", "$type": "color" },
        "300": { "$value": "#91B6FF", "$type": "color" },
        "400": { "$value": "#5B8FFF", "$type": "color" },
        "500": { "$value": "#2F6BFF", "$type": "color" },
        "600": { "$value": "#1E4DFF", "$type": "color" },
        "700": { "$value": "#173ACB", "$type": "color" },
        "800": { "$value": "#122D9B", "$type": "color" },
        "900": { "$value": "#0C1F6D", "$type": "color" },
        "950": { "$value": "#07143E", "$type": "color" }
      },
      "accent": {
        "cyan": { "$value": "#56D7FF", "$type": "color" },
        "cyanLight": { "$value": "#CFF5FF", "$type": "color" }
      },
      "neutral": {
        "0": { "$value": "#FFFFFF", "$type": "color" },
        "25": { "$value": "#FCFDFF", "$type": "color" },
        "50": { "$value": "#F7F9FD", "$type": "color" },
        "100": { "$value": "#EEF2F8", "$type": "color" },
        "200": { "$value": "#DEE5F0", "$type": "color" },
        "400": { "$value": "#98A4B8", "$type": "color" },
        "600": { "$value": "#5B6884", "$type": "color" },
        "800": { "$value": "#24314D", "$type": "color" },
        "950": { "$value": "#081331", "$type": "color" }
      },
      "semantic": {
        "success": { "$value": "#15966A", "$type": "color" },
        "warning": { "$value": "#D98B10", "$type": "color" },
        "error": { "$value": "#D64545", "$type": "color" },
        "focus": { "$value": "#56D7FF", "$type": "color" }
      }
    },
    "space": {
      "0": { "$value": "0px", "$type": "dimension" },
      "1": { "$value": "4px", "$type": "dimension" },
      "2": { "$value": "8px", "$type": "dimension" },
      "3": { "$value": "12px", "$type": "dimension" },
      "4": { "$value": "16px", "$type": "dimension" },
      "5": { "$value": "20px", "$type": "dimension" },
      "6": { "$value": "24px", "$type": "dimension" },
      "8": { "$value": "32px", "$type": "dimension" },
      "10": { "$value": "40px", "$type": "dimension" },
      "12": { "$value": "48px", "$type": "dimension" },
      "16": { "$value": "64px", "$type": "dimension" },
      "20": { "$value": "80px", "$type": "dimension" },
      "24": { "$value": "96px", "$type": "dimension" },
      "30": { "$value": "120px", "$type": "dimension" },
      "40": { "$value": "160px", "$type": "dimension" }
    },
    "radius": {
      "small": { "$value": "12px", "$type": "dimension" },
      "medium": { "$value": "16px", "$type": "dimension" },
      "large": { "$value": "24px", "$type": "dimension" },
      "xlarge": { "$value": "28px", "$type": "dimension" },
      "pill": { "$value": "999px", "$type": "dimension" }
    },
    "shadow": {
      "small": { "$value": { "color": "#0813310D", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" }, "$type": "shadow" },
      "medium": { "$value": { "color": "#08133114", "offsetX": "0px", "offsetY": "18px", "blur": "48px", "spread": "0px" }, "$type": "shadow" },
      "brandGlow": { "$value": { "color": "#1E4DFF33", "offsetX": "0px", "offsetY": "18px", "blur": "56px", "spread": "0px" }, "$type": "shadow" }
    }
  }
}
